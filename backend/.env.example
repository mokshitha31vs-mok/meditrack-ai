# MediTrack AI Backend Production Environment Variables
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Cryptographic Secrets (Generate strong random 64-char strings in production)
SECRET_KEY=replace-with-secure-random-production-secret-key-min-64-chars
JWT_SECRET_KEY=replace-with-secure-random-production-jwt-key-min-64-chars

# Persistent Database (SQLite for local/test, PostgreSQL for production deployment)
DATABASE_URL=sqlite:///meditrack.db
# DATABASE_URL=postgresql://meditrack_user:strong_password@localhost:5432/meditrack_prod

# CORS Allowed Origin (Custom Domain)
CORS_ORIGIN=https://app.meditrack.ai,http://localhost:5173,http://localhost:3000

# File Upload Limits
MAX_CONTENT_LENGTH=15728640
